# Database. Leave unset locally to use SQLite (./jobs.db).
# In CI/production, MUST point to a persistent Postgres (e.g. Supabase) —
# GitHub Actions runners are ephemeral and a SQLite file does not survive
# between runs, which would break deduplication and cause every job to be
# re-notified as "new" on every scan.
# Example: postgresql+psycopg2://user:password@host:5432/postgres
DATABASE_URL=

# Anthropic API key, used only for Layer 3 (borderline-job) matching.
ANTHROPIC_API_KEY=

# Telegram bot used for notifications. Create a bot via @BotFather to get
# the token; message the bot once, then hit
# https://api.telegram.org/bot<token>/getUpdates to find your chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Minimum score (0-100) required to send a notification.
MATCH_THRESHOLD=80

# When true, lowers the effective notification threshold and keeps
# borderline/unconventional-title roles that would otherwise be dropped.
HIGH_RECALL_MODE=true
